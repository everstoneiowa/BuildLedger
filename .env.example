# Leave DATABASE_URL empty to use the built-in embedded Postgres (PGlite), stored in ./.data/db
# Set it to a real PostgreSQL server for production, e.g. postgres://user:pass@host:5432/buildledger
DATABASE_URL=

# Long random string. Encrypts bank account numbers and tax IDs. REQUIRED in production; never change it after go-live.
APP_SECRET=

# Where uploaded files are stored (private, never served directly)
STORAGE_DIR=./.data/files

# Optional: enables AI-assisted invoice/receipt data extraction
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
